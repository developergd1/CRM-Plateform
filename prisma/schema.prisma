datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. AUTHENTICATION & RBAC
// ----------------------------------------------------

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  passwordHash   String
  roleId         String    @db.ObjectId
  role           Role      @relation(fields: [roleId], references: [id])
  isActive       Boolean   @default(true)
  isSuspended    Boolean   @default(false)
  failedAttempts Int       @default(0)
  lockoutUntil   DateTime?
  lastLoginAt    DateTime?
  mfaSecret      String?
  mfaEnabled     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employeeProfile Employee?
  clientProfile   Client?
  workSessions    WorkSession[]
  auditLogs       AuditLog[]
  sessions        ActiveUserSession[]

  // Delegated Access & Account Sharing
  isDelegated          Boolean   @default(false)
  parentUserId         String?   @db.ObjectId
  parentClientId       String?   @db.ObjectId
  delegatedPermissions String?   // JSON string array of permission codes
  invitationId         String?   @db.ObjectId

  @@index([roleId])
  @@index([parentUserId])
  @@index([parentClientId])
}

model ActiveUserSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  deviceType   String?
  isValid      Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String           @unique // SUPER_ADMIN, ADMIN_HR, MANAGER_TL, EMPLOYEE, ADMIN, CLIENT
  displayName String
  description String?
  isSystem    Boolean          @default(true)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  code        String           @unique
  module      String
  description String
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String     @db.ObjectId
  permissionId String     @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ----------------------------------------------------
// 1B. SHARED ACCOUNT INVITATIONS & DELEGATED RBAC
// ----------------------------------------------------

model AccountInvitation {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  token           String    @unique
  name            String
  email           String
  designation     String?
  inviterUserId   String    @db.ObjectId
  inviterRole     String    // 'ADMIN' | 'CLIENT'
  clientId        String?   @db.ObjectId
  permissions     String    // JSON array string of permission codes e.g. ["crm-leads", "employees"]
  status          String    @default("ACTIVE") // 'ACTIVE' (valid until revoked) | 'REVOKED' | 'ACCEPTED'
  revokedAt       DateTime?
  revokedBy       String?
  acceptedAt      DateTime?
  acceptedUserId  String?   @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([inviterUserId])
  @@index([email])
  @@index([status])
  @@index([clientId])
}

// ----------------------------------------------------
// 2. ORGANIZATION & EMPLOYEES (PHASE 1 CORE + HRMS)
// ----------------------------------------------------

model Department {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  code        String     @unique
  description String?
  teams       Team[]
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Team {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  departmentId   String     @db.ObjectId
  department     Department @relation(fields: [departmentId], references: [id])
  leadEmployeeId String?
  employees      Employee[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([departmentId])
}

model Employee {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String @unique // e.g. GI-EMP-000001
  userId     String @unique @db.ObjectId
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Client Relation (Phase 1: Selected Client)
  clientId String? @db.ObjectId
  client   Client? @relation("ClientEmployees", fields: [clientId], references: [id])

  // Personal Information (Phase 1 Specs)
  fullName         String
  fatherMotherName String?
  dob              DateTime?
  gender           String?
  phone            String    @unique
  personalEmail    String?
  panNumber        String?
  panMasked        String?
  aadhaarMasked    String?
  address          String?
  profilePhotoUrl  String?
  emergencyContact String?
  emergencyName    String?

  // Employment Information (Phase 1 Specs)
  departmentId     String?     @db.ObjectId
  department       Department? @relation(fields: [departmentId], references: [id])
  departmentName   String? // Direct text or relation name
  teamId           String?     @db.ObjectId
  team             Team?       @relation(fields: [teamId], references: [id])
  designation      String
  jobLocation      String      @default("Headquarters")
  location         String      @default("Headquarters")
  joiningDate      DateTime    @default(now())
  probationEndDate DateTime?
  employmentType   String      @default("Full-Time") // Full-Time, Contract, Part-Time, Intern, Consultant
  workMode         String      @default("OFFICE")
  shiftStartTime   String      @default("09:30")
  shiftEndTime     String      @default("18:30")
  remarks          String?

  // Status & Block/Unblock Management (Phase 1 Specs)
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  isBlocked      Boolean   @default(false)
  blockedReason  String?
  blockedRemarks String?
  blockedBy      String?
  blockedAt      DateTime?
  unblockedBy    String?
  unblockedAt    DateTime?

  // Audit Info (Phase 1 Specs)
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Manager Hierarchy
  reportingManagerId String?    @db.ObjectId
  reportingManager   Employee?  @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinates       Employee[] @relation("ManagerSubordinates")

  // Relationships
  blockHistories    EmployeeBlockHistory[]
  documents         EmployeeDocument[]
  attendanceRecords Attendance[]
  workSessions      WorkSession[]
  leaveRequests     LeaveRequest[]
  allocatedAssets   Asset[]

  // CRM Relationships (Legacy Client specific)
  createdClients      Client[]           @relation("ClientCreator")
  assignedClients     Client[]           @relation("ClientOwner")
  assignedHistory     ClientAssignment[] @relation("AssignedToHistory")
  executedHistory     ClientAssignment[] @relation("AssignedByHistory")
  activitiesPerformed ClientActivity[]
  notesWritten        ClientNote[]
  tasksAssigned       ClientTask[]       @relation("TaskAssignee")
  tasksCreated        ClientTask[]       @relation("TaskCreator")
  notifications       Notification[]

  // CRM Generalized Relationships
  assignedLeads      Lead[]        @relation("LeadOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  ownedDeals         Deal[]        @relation("DealOwner")
  assignedActivities Activity[]    @relation("ActivityAssignee")
  assignedCrmTasks   Task[]        @relation("CrmTaskAssignee")
  createdCrmTasks    Task[]        @relation("CrmTaskCreator")
  reviewedCrmTasks   Task[]        @relation("CrmTaskReviewer")
  authoredCrmNotes   Note[]        @relation("CrmNoteAuthor")

  // Task Extensions
  taskCommentsAuthored TaskComment[] @relation("TaskCommentAuthor")
  taskHistoryActions   TaskHistory[] @relation("TaskHistoryActor")

  // Lead Assignments & Follow-ups
  leadAssignmentsFrom LeadAssignment[]   @relation("LeadReassignFrom")
  leadAssignmentsTo   LeadAssignment[]   @relation("LeadReassignTo")
  leadAssignmentsBy   LeadAssignment[]   @relation("LeadReassignBy")
  assignedFollowUps   FollowUp[]         @relation("FollowUpAssignee")
  createdFollowUps    FollowUp[]         @relation("FollowUpCreator")
  changedDealStages   DealStageHistory[] @relation("DealStageChanger")
  ownedClientAccounts Client[]           @relation("ClientAccountOwner")
  ownedAccounts       Account[]          @relation("AccountOwner")

  // HRM & Payroll Relationships
  leaveBalances        LeaveBalance[]
  leaveLedgers         LeaveLedger[]
  goals                Goal[]
  performanceReviews   PerformanceReview[]
  hrRequests           HrRequest[]
  helpdeskTickets      HelpdeskTicket[]
  salaryAssignments    EmployeeSalaryAssignment[]
  payrollRecords       PayrollRecord[]
  reimbursementClaims  ReimbursementClaim[]
  loans                EmployeeLoan[]
  payslips             Payslip[]
  policyAcknowledgments HrPolicyAcknowledgment[]

  @@index([status])
  @@index([clientId])
  @@index([departmentId])
}

// ----------------------------------------------------
// 3. EMPLOYEE BLOCK & UNBLOCK HISTORY (PHASE 1 CORE)
// ----------------------------------------------------

model EmployeeBlockHistory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId     String   @db.ObjectId
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actionType     String // BLOCK or UNBLOCK
  reason         String
  remarks        String?
  actionBy       String // Admin Name / ID
  actionDate     DateTime @default(now())
  previousStatus String
  newStatus      String

  @@index([employeeId])
  @@index([actionDate])
  @@index([actionType])
}

// ----------------------------------------------------
// 4. CLIENT MANAGEMENT (PHASE 1 CORE + CRM EXPANSION)
// ----------------------------------------------------

model Client {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  clientId String @unique // e.g. CLI-00001

  // Phase 1 Fields
  companyName        String   // Company Name
  contactPerson      String   // Contact Person
  mobile             String   // Mobile Number
  email              String?
  address            String?
  industry           String?  // IT, Manufacturing, Logistics, Healthcare, Finance, Retail, etc.
  companyType        String?  // Private Limited, Partnership, LLP, Sole Proprietorship, Public Limited
  gst                String?  // GST Number
  remarks            String?  // Onboarding Remarks
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE
  dateAdded          DateTime @default(now())
  assignedModules    String[] // ["EMS", "CRM", "HRM"]
  subscriptionPlan   String?  @default("STANDARD")
  subscriptionStatus String?  @default("ACTIVE")
  updatedById        String?

  // Authentication & Governance (Phase 1)
  userId             String? @unique @db.ObjectId
  user               User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  canBlockEmployees  Boolean @default(false)
  canDeleteEmployees Boolean @default(false)

  // Backwards compatibility & CRM fields
  name           String?
  phone          String?
  company        String?
  location       String?
  source         String  @default("Direct Call")
  requirement    String?
  estimatedValue Float?  @default(0)
  priority       String  @default("MEDIUM")
  stage          String  @default("NEW")

  // Extended Part 4 Fields
  legalName      String?
  alternatePhone String?
  website        String?
  city           String?
  state          String?
  country        String?   @default("India")
  onboardingDate DateTime?
  salesOwnerId   String?   @db.ObjectId
  accountOwnerId String?   @db.ObjectId
  accountOwner   Employee? @relation("ClientAccountOwner", fields: [accountOwnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Ownership
  createdById        String?   @db.ObjectId
  createdBy          Employee? @relation("ClientCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedEmployeeId String?   @db.ObjectId
  assignedEmployee   Employee? @relation("ClientOwner", fields: [assignedEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  lastContactedAt    DateTime?
  nextFollowUpDate   DateTime?
  tags               String    @default("[]")
  isDuplicateMerged  Boolean   @default(false)
  mergedIntoClientId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relationships
  employees       Employee[]              @relation("ClientEmployees")
  assignments     ClientAssignment[]
  activities      ClientActivity[]
  notes           ClientNote[]
  tasks           ClientTask[]
  pipelineHistory ClientPipelineHistory[]

  // Generalized CRM Relations
  leads         Lead[]
  contacts      Contact[]
  opportunities Opportunity[]
  deals         Deal[]
  crmActivities Activity[]
  crmTasks      Task[]
  crmNotes      Note[]
  followUps     FollowUp[]
  accounts      Account[]               @relation("AccountClientBridge")

  // Part 4 Organizational Relations
  departments ClientDepartment[]
  documents   ClientDocument[]

  @@index([mobile])
  @@index([status])
  @@index([industry])
  @@index([assignedEmployeeId])
  @@index([accountOwnerId])
  @@index([createdAt])
}

model ClientDepartment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String   @db.ObjectId
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?
  managerId   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, name])
  @@index([clientId])
}

model ClientDocument {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId   String   @db.ObjectId
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title      String
  category   String // AGREEMENT, CONTRACT, PROPOSAL, COMPANY_DOC, COMPLIANCE, OTHER
  fileUrl    String?
  fileType   String?
  fileSize   Int?
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
  @@index([category])
}

model ClientAssignment {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId         String   @db.ObjectId
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromEmployeeId   String?  @db.ObjectId
  toEmployeeId     String   @db.ObjectId
  toEmployee       Employee @relation("AssignedToHistory", fields: [toEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedById     String   @db.ObjectId
  assignedBy       Employee @relation("AssignedByHistory", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignmentReason String?
  assignedAt       DateTime @default(now())

  @@index([clientId])
  @@index([toEmployeeId])
}

model ClientPipelineHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String   @db.ObjectId
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStage   String
  toStage     String
  changedById String
  remarks     String?
  timestamp   DateTime @default(now())

  @@index([clientId])
  @@index([toStage])
}

model ClientActivity {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  activityId      String   @unique
  clientId        String   @db.ObjectId
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorEmployeeId String   @db.ObjectId
  actorEmployee   Employee @relation(fields: [actorEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activityType    String
  title           String
  description     String?
  previousValue   String?
  newValue        String?
  metadata        String?
  ipAddress       String?
  timestamp       DateTime @default(now())

  @@index([clientId])
  @@index([actorEmployeeId])
  @@index([timestamp])
  @@index([activityType])
}

model ClientNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId  String   @db.ObjectId
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String   @db.ObjectId
  author    Employee @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model ClientTask {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  taskId          String    @unique
  clientId        String    @db.ObjectId
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedToId    String    @db.ObjectId
  assignedTo      Employee  @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById     String    @db.ObjectId
  createdBy       Employee  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taskType        String
  title           String
  description     String?
  priority        String    @default("MEDIUM")
  dueDate         DateTime
  reminderTime    DateTime?
  status          String    @default("PENDING")
  completedAt     DateTime?
  completionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
}

// ----------------------------------------------------
// 5. SECURE KYC & DOCUMENT VAULT (FUTURE READY)
// ----------------------------------------------------

model EmployeeDocument {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  documentId         String    @unique
  employeeId         String    @db.ObjectId
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType       String
  title              String
  fileStoragePath    String
  mimeType           String    @default("application/pdf")
  fileSizeBytes      Int       @default(102400)
  verificationStatus String    @default("PENDING_VERIFICATION")
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?
  expiryDate         DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accessLogs DocumentAccessLog[]

  @@index([employeeId])
  @@index([documentType])
  @@index([verificationStatus])
}

model DocumentAccessLog {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  documentId           String           @db.ObjectId
  document             EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accessedByEmployeeId String
  actionType           String
  ipAddress            String?
  userAgent            String?
  accessedAt           DateTime         @default(now())

  @@index([documentId])
  @@index([accessedByEmployeeId])
}

// ----------------------------------------------------
// 6. ATTENDANCE & WORK SESSIONS (FUTURE READY)
// ----------------------------------------------------

model Attendance {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  employeeId        String    @db.ObjectId
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date              String
  checkInTime       DateTime?
  checkOutTime      DateTime?
  status            String    @default("PRESENT")
  isLate            Boolean   @default(false)
  isEarlyCheckout   Boolean   @default(false)
  totalWorkMinutes  Int       @default(0)
  totalBreakMinutes Int       @default(0)
  overtimeMinutes   Int       @default(0)
  checkInIp         String?
  checkOutIp        String?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  breaks AttendanceBreak[]

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

model AttendanceBreak {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  attendanceId    String     @db.ObjectId
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  breakStartTime  DateTime   @default(now())
  breakEndTime    DateTime?
  durationMinutes Int        @default(0)
  breakType       String     @default("TEA_LUNCH")
  createdAt       DateTime   @default(now())

  @@index([attendanceId])
}

model WorkSession {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  sessionId          String    @unique
  userId             String    @db.ObjectId
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId         String    @db.ObjectId
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loginTimestamp     DateTime  @default(now())
  logoutTimestamp    DateTime?
  sessionDurationSec Int       @default(0)
  activeSeconds      Int       @default(0)
  ipAddress          String?
  userAgent          String?
  deviceInfo         String?
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ----------------------------------------------------
// 7. LEAVE & ASSET MANAGEMENT (FUTURE READY)
// ----------------------------------------------------

model LeaveRequest {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String               @db.ObjectId
  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       String
  startDate       String
  endDate         String
  totalDays       Float
  reason          String
  remarks         String?
  attachmentUrl   String?
  rejectionReason String?
  status          String               @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  reviewedById    String?
  reviewedAt      DateTime?
  reviewRemarks   String?
  cancelledAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  auditTrail      LeaveActionHistory[]

  @@index([employeeId])
  @@index([status])
}

model LeaveActionHistory {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  leaveId         String       @db.ObjectId
  leave           LeaveRequest @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  action          String       // APPLIED, APPROVED, REJECTED, CANCELLED
  performedBy     String       // Full name or identifier
  performerRole   String       // EMPLOYEE, CLIENT, ADMIN, HR
  performerId     String?      // user ID or employee ID
  previousStatus  String?
  newStatus       String
  rejectionReason String?
  remarks         String?
  timestamp       DateTime     @default(now())

  @@index([leaveId])
}


model Asset {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  assetTag           String    @unique
  name               String
  assetType          String
  serialNumber       String    @unique
  assignedEmployeeId String?   @db.ObjectId
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])
  assignedDate       DateTime?
  returnDate         DateTime?
  condition          String    @default("GOOD")
  status             String    @default("ALLOCATED")
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([assignedEmployeeId])
}

// ----------------------------------------------------
// 8. NOTIFICATIONS & IMMUTABLE AUDIT LOGS
// ----------------------------------------------------

model Notification {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  recipientId String    @db.ObjectId
  recipient   Employee  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  message     String
  category    String
  entityType  String?
  entityId    String?
  actionUrl   String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId])
  @@index([isRead])
  @@index([recipientId, isRead])
  @@index([createdAt])
}

model AutomationLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  event      String // e.g. FOLLOW_UP_DUE, DEAL_WON, ATTENDANCE_LATE
  action     String // e.g. SEND_NOTIFICATION, CONVERT_DEAL_TO_CLIENT
  entityType String // e.g. FollowUp, Deal, Attendance, Lead
  entityId   String
  status     String   @default("SUCCESS") // SUCCESS, SKIPPED, FAILED
  message    String?
  metadata   String?
  executedAt DateTime @default(now())

  @@index([event])
  @@index([entityType, entityId])
  @@index([executedAt])
}

model AuditLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  actorUserId     String?  @db.ObjectId
  actorUser       User?    @relation(fields: [actorUserId], references: [id])
  actorEmployeeId String?
  action          String
  entityType      String
  entityId        String?
  previousData    String?
  newData         String?
  reason          String?
  ipAddress       String?
  userAgent       String?
  status          String   @default("SUCCESS")
  timestamp       DateTime @default(now())

  @@index([actorEmployeeId])
  @@index([action])
  @@index([entityType])
  @@index([timestamp])
}

model SystemSetting {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  key                 String   @unique
  value               String
  category            String
  description         String?
  updatedByEmployeeId String?
  updatedAt           DateTime @updatedAt
}

// ----------------------------------------------------
// 9. GENERALIZED CRM MODELS (ENTERPRISE EXPANSION)
// ----------------------------------------------------

model Lead {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  leadNumber      String    @unique // e.g. LEAD-000001
  companyName     String // Company Name
  contactPerson   String // Contact Person
  fullName        String? // Backward compatibility alias for contactPerson
  email           String?
  phone           String
  alternatePhone  String?
  website         String?
  industry        String?
  location        String?
  city            String?
  state           String?
  country         String?   @default("India")
  source          String    @default("WEBSITE") // WEBSITE, REFERRAL, COLD_CALL, EMAIL, LINKEDIN, ADVERTISEMENT, CAMPAIGN, MANUAL, OTHER
  status          String    @default("NEW") // NEW, CONTACTED, QUALIFIED, FOLLOW_UP, UNQUALIFIED, CONVERTED, LOST
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  leadScore       Int       @default(0)
  estimatedValue  Float?    @default(0)
  description     String?
  isArchived      Boolean   @default(false)
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  createdBy       String?

  // Organization / Tenant linkage (nullable for raw inbound leads before client association)
  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Assigned Employee
  assignedToId String?   @db.ObjectId
  assignedTo   Employee? @relation("LeadOwner", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Conversion link
  convertedAt          DateTime?
  convertedById        String?
  convertedAccountId   String?
  convertedToContactId String?
  convertedToDealId    String?

  // Relations
  contacts      Contact[]
  opportunities Opportunity[]
  deals         Deal[]
  activities    Activity[]
  tasks         Task[]
  notes         Note[]
  assignments   LeadAssignment[]
  followUps     FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([clientId])
  @@index([assignedToId])
  @@index([phone])
  @@index([companyName])
  @@index([createdAt])
  @@index([nextFollowUpAt])
}

model LeadAssignment {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  leadId           String    @db.ObjectId
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromEmployeeId   String?   @db.ObjectId
  fromEmployee     Employee? @relation("LeadReassignFrom", fields: [fromEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toEmployeeId     String    @db.ObjectId
  toEmployee       Employee  @relation("LeadReassignTo", fields: [toEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedById     String    @db.ObjectId
  assignedBy       Employee  @relation("LeadReassignBy", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignmentReason String?
  assignedAt       DateTime  @default(now())

  @@index([leadId])
  @@index([toEmployeeId])
  @@index([assignedAt])
}

model Contact {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  contactNumber   String  @unique // e.g. CON-000001
  fullName        String
  designation     String?
  email           String?
  phone           String
  alternatePhone  String?
  isDecisionMaker Boolean @default(false)
  isPrimary       Boolean @default(false)
  department      String?
  status          String  @default("ACTIVE")
  notes           String?
  isArchived      Boolean @default(false)

  // Belongs to Organization (Client) or Lead or Commercial Account
  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  leadId String? @db.ObjectId
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  accountId    String?  @db.ObjectId
  account      Account? @relation("AccountContacts", fields: [accountId], references: [id], onDelete: SetNull)
  decisionRole String?  @default("OTHER") // DECISION_MAKER, INFLUENCER, CHAMPION, USER, GATEKEEPER, FINANCE, PROCUREMENT, OTHER

  // Relations
  opportunities Opportunity[]
  deals         Deal[]
  activities    Activity[]
  tasks         Task[]
  notesRel      Note[]
  followUps     FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([leadId])
  @@index([accountId])
  @@index([phone])
  @@index([email])
}

model FollowUp {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  followUpNumber String    @unique // e.g. FLW-000001
  title          String
  remarks        String?
  scheduledAt    DateTime
  completedAt    DateTime?
  status         String    @default("PENDING") // PENDING, COMPLETED, CANCELLED, RESCHEDULED
  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT

  leadId String? @db.ObjectId
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  contactId String?  @db.ObjectId
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  opportunityId String?      @db.ObjectId
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  dealId String? @db.ObjectId
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  assignedToId String?   @db.ObjectId
  assignedTo   Employee? @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String?   @db.ObjectId
  createdBy   Employee? @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([contactId])
  @@index([clientId])
  @@index([opportunityId])
  @@index([dealId])
  @@index([assignedToId])
  @@index([status])
  @@index([scheduledAt])
}

model Opportunity {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  opportunityNumber String    @unique // e.g. OPP-000001
  title             String
  description       String?
  value             Float     @default(0) // Estimated Value
  currency          String    @default("INR")
  stage             String    @default("PROSPECTING") // PROSPECTING, QUALIFICATION, PROPOSAL, NEGOTIATION, CLOSED_WON, CLOSED_LOST
  probability       Int       @default(20)
  expectedCloseDate DateTime?
  productService    String?
  competitor        String?
  proposalStatus    String    @default("NOT_REQUIRED")
  wonReason         String?
  lossReason        String?
  createdBy         String?
  closedAt          DateTime?

  // Nullable Client ID before conversion
  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  leadId String? @db.ObjectId
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  primaryContactId String?  @db.ObjectId
  primaryContact   Contact? @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)

  assignedToId String?   @db.ObjectId
  assignedTo   Employee? @relation("OpportunityOwner", fields: [assignedToId], references: [id], onDelete: SetNull)

  deals      Deal[]
  followUps  FollowUp[]
  activities Activity[]
  tasks      Task[]
  notes      Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([leadId])
  @@index([stage])
  @@index([assignedToId])
  @@index([createdAt])
}

model Deal {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  dealNumber        String    @unique // e.g. DEAL-000001
  title             String
  amount            Float     @default(0) // Deal Value
  probability       Int       @default(50) // 0-100%
  weightedValue     Float     @default(0) // amount * probability / 100
  currency          String    @default("INR")
  stage             String    @default("NEW") // NEW, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  status            String    @default("OPEN") // OPEN, WON, LOST, CANCELLED
  proposalStatus    String    @default("NOT_REQUIRED") // NOT_REQUIRED, DRAFT, PREPARED, SENT, VIEWED, ACCEPTED, REJECTED
  productService    String?
  competitor        String?
  competitorNotes   String?
  wonReason         String?
  lostReason        String?
  closingNotes      String?
  terms             String?
  startDate         DateTime?
  closingDate       DateTime?
  expectedCloseDate DateTime?
  closedAt          DateTime?

  // Client Conversion Bridge
  isConvertedToClient Boolean @default(false)
  convertedToClientId String? @db.ObjectId

  // Commercial Account Relation
  accountId           String?        @db.ObjectId
  account             Account?       @relation("AccountDeals", fields: [accountId], references: [id], onDelete: SetNull)

  // Dynamic Pipeline & Stage Relations
  pipelineId          String?        @db.ObjectId
  pipeline            Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageId             String?        @db.ObjectId
  pipelineStage       PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  // Won / Lost Tracking
  wonAt               DateTime?
  lostAt              DateTime?

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  leadId String? @db.ObjectId
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  primaryContactId String?  @db.ObjectId
  primaryContact   Contact? @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)

  opportunityId String?      @db.ObjectId
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  assignedToId String?   @db.ObjectId
  assignedTo   Employee? @relation("DealOwner", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdBy String?

  stageHistory DealStageHistory[]
  followUps    FollowUp[]
  activities   Activity[]
  tasks        Task[]
  notes        Note[]

  // Commercial Subsystems
  lineItems    DealLineItem[]
  quotes       Quote[]
  contracts    Contract[]
  handoffs     ClientHandoff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([leadId])
  @@index([accountId])
  @@index([opportunityId])
  @@index([stage])
  @@index([status])
  @@index([assignedToId])
  @@index([expectedCloseDate])
  @@index([createdAt])
}

model DealStageHistory {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  dealId          String    @db.ObjectId
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage       String?
  toStage         String
  fromProbability Int?
  toProbability   Int?
  changedById     String?   @db.ObjectId
  changedBy       Employee? @relation("DealStageChanger", fields: [changedById], references: [id], onDelete: SetNull)
  reason          String?
  changedAt       DateTime  @default(now())

  @@index([dealId])
  @@index([changedAt])
}

model Activity {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  activityNumber  String    @unique // e.g. ACT-000001
  type            String // CALL, MEETING, EMAIL, NOTE, TASK, WHATSAPP, SYSTEM
  subject         String
  description     String?
  durationMinutes Int?      @default(0)
  scheduledAt     DateTime?
  completedAt     DateTime?
  status          String    @default("COMPLETED") // SCHEDULED, COMPLETED, CANCELLED

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  leadId String? @db.ObjectId
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  contactId String?  @db.ObjectId
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  opportunityId String?      @db.ObjectId
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  dealId String? @db.ObjectId
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  accountId String?  @db.ObjectId
  account   Account? @relation("AccountActivities", fields: [accountId], references: [id], onDelete: SetNull)

  performedById String?   @db.ObjectId
  performedBy   Employee? @relation("ActivityAssignee", fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([leadId])
  @@index([accountId])
  @@index([performedById])
  @@index([type])
  @@index([scheduledAt])
}

model Task {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  taskNumber          String    @unique // e.g. TSK-000001
  title               String
  description         String?
  priority            String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status              String    @default("TODO") // TODO, ACCEPTED, IN_PROGRESS, WAITING_FOR_REVIEW, CHANGES_REQUESTED, COMPLETED, OVERDUE, CANCELLED
  dueDate             DateTime?
  reminderTime        DateTime?
  completedAt         DateTime?
  expectedDeliverable String?
  attachments         String[]  @default([])

  // Submission fields
  submissionSummary String?
  submissionNotes   String?
  submissionLinks   String[]  @default([])
  submissionFiles   String[]  @default([])
  submittedAt       DateTime?

  // Review fields
  feedbackNotes String?
  reviewedAt    DateTime?
  reviewedById  String?   @db.ObjectId
  reviewedBy    Employee? @relation("CrmTaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  leadId String? @db.ObjectId
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  contactId String?  @db.ObjectId
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  opportunityId String?      @db.ObjectId
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  dealId String? @db.ObjectId
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  assignedToId String?   @db.ObjectId
  assignedTo   Employee? @relation("CrmTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String?   @db.ObjectId
  createdBy   Employee? @relation("CrmTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments TaskComment[]
  history  TaskHistory[]

  @@index([clientId])
  @@index([leadId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model Note {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  content  String
  isPinned Boolean @default(false)

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  leadId String? @db.ObjectId
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  contactId String?  @db.ObjectId
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  opportunityId String?      @db.ObjectId
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  dealId String? @db.ObjectId
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  authorId String?   @db.ObjectId
  author   Employee? @relation("CrmNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([leadId])
  @@index([authorId])
}

model TaskComment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId      String   @db.ObjectId
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String   @db.ObjectId
  author      Employee @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  attachments String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
  @@index([authorId])
}

model TaskHistory {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId        String   @db.ObjectId
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId       String   @db.ObjectId
  actor         Employee @relation("TaskHistoryActor", fields: [actorId], references: [id], onDelete: Cascade)
  action        String // e.g. CREATED, STATUS_CHANGE, SUBMITTED, REVIEWED, ASSIGNED
  previousValue String?
  newValue      String?
  remarks       String?
  timestamp     DateTime @default(now())

  @@index([taskId])
  @@index([actorId])
}

// ----------------------------------------------------
// 10. ENTERPRISE COMMERCIAL CRM MODELS
// ----------------------------------------------------

model Account {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  accountCode     String    @unique // e.g. ACC-00001
  companyName     String
  legalName       String?
  industry        String?
  companySize     String?   // 1-10, 11-50, 51-200, 201-500, 500+
  website         String?
  email           String?
  phone           String
  city            String?
  state           String?
  country         String    @default("India")
  address         String?
  status          String    @default("PROSPECT") // PROSPECT, ACTIVE, INACTIVE, CUSTOMER, FORMER_CUSTOMER
  accountType     String    @default("COMMERCIAL") // COMMERCIAL, ENTERPRISE, SMB, PARTNER
  source          String    @default("DIRECT")
  annualRevenue   Float?    @default(0)

  // Ownership & Tenant Scoping
  ownerId         String?   @db.ObjectId
  owner           Employee? @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teamId          String?   @db.ObjectId

  // Link to Client Management (Only populated after handoff / provisioning)
  clientId        String?   @db.ObjectId
  client          Client?   @relation("AccountClientBridge", fields: [clientId], references: [id], onDelete: SetNull)

  // Commercial Relations
  contacts        Contact[]       @relation("AccountContacts")
  deals           Deal[]          @relation("AccountDeals")
  quotes          Quote[]         @relation("AccountQuotes")
  contracts       Contract[]      @relation("AccountContracts")
  renewals        Renewal[]       @relation("AccountRenewals")
  activities      Activity[]      @relation("AccountActivities")
  handoffs        ClientHandoff[] @relation("AccountHandoffs")

  // Audit & Metadata
  tags            String[]  @default([])
  customFields    String?   // JSON key-value store for custom fields
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyName])
  @@index([status])
  @@index([ownerId])
  @@index([clientId])
}

model Pipeline {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String          // e.g. "Standard B2B Sales Pipeline"
  code        String          @unique // e.g. "STANDARD_B2B"
  isDefault   Boolean         @default(false)
  isActive    Boolean         @default(true)
  stages      PipelineStage[]
  deals       Deal[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PipelineStage {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  pipelineId     String    @db.ObjectId
  pipeline       Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name           String    // Discovery, Solution Qualified, Proposal, Negotiation, Closed Won, Closed Lost
  order          Int       // 1, 2, 3, 4, 5, 6
  probability    Int       // 10, 30, 60, 80, 100, 0
  colorToken     String    @default("olive") // olive, amber, neutral, red
  requiredFields String[]  @default([]) // Field keys required before entering stage
  isWon          Boolean   @default(false)
  isLost         Boolean   @default(false)
  deals          Deal[]
  createdAt      DateTime  @default(now())

  @@index([pipelineId, order])
}

model Product {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  productCode String         @unique // e.g. PRD-00001
  name        String
  type        String         @default("PRODUCT") // PRODUCT, SERVICE, SUBSCRIPTION
  category    String?
  description String?
  unit        String         @default("UNIT") // UNIT, MONTH, HOUR, USER, LICENSE
  unitPrice   Float          @default(0)
  currency    String         @default("INR")
  taxRate     Float          @default(18.0) // 18% GST default
  isActive    Boolean        @default(true)
  dealItems   DealLineItem[]
  quoteItems  QuoteItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isActive])
}

model DealLineItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  dealId      String   @db.ObjectId
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id])
  description String?
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(18.0)
  subtotal    Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([dealId])
}

model Quote {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  quoteNumber  String      @unique // e.g. QUO-00001
  version      Int         @default(1)
  dealId       String      @db.ObjectId
  deal         Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  accountId    String      @db.ObjectId
  account      Account     @relation("AccountQuotes", fields: [accountId], references: [id])
  status       String      @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  issueDate    DateTime    @default(now())
  expiryDate   DateTime?
  subtotal     Float       @default(0)
  discount     Float       @default(0)
  tax          Float       @default(0)
  total        Float       @default(0)
  terms        String?
  notes        String?
  items        QuoteItem[]
  contracts    Contract[]
  createdById  String?     @db.ObjectId
  approvedById String?     @db.ObjectId
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([dealId])
  @@index([accountId])
  @@index([status])
}

model QuoteItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  quoteId     String   @db.ObjectId
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id])
  description String?
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(18.0)
  total       Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([quoteId])
}

model Contract {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  contractNumber String    @unique // e.g. CONTRACT-00001
  accountId      String    @db.ObjectId
  account        Account   @relation("AccountContracts", fields: [accountId], references: [id])
  dealId         String    @db.ObjectId
  deal           Deal      @relation(fields: [dealId], references: [id])
  quoteId        String?   @db.ObjectId
  quote          Quote?    @relation(fields: [quoteId], references: [id])
  contractType   String    @default("STANDARD") // STANDARD, MSA, SLA, SUBSCRIPTION
  status         String    @default("ACTIVE") // DRAFT, PENDING_APPROVAL, ACTIVE, EXPIRED, TERMINATED, RENEWED
  startDate      DateTime
  endDate        DateTime
  renewalDate    DateTime?
  value          Float     @default(0)
  currency       String    @default("INR")
  ownerId        String?   @db.ObjectId
  documentId     String?
  notes          String?
  renewals       Renewal[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([accountId])
  @@index([dealId])
  @@index([status])
  @@index([endDate])
}

model Renewal {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  renewalNumber  String    @unique // e.g. REN-00001
  accountId      String    @db.ObjectId
  account        Account   @relation("AccountRenewals", fields: [accountId], references: [id])
  contractId     String    @db.ObjectId
  contract       Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  previousDealId String    @db.ObjectId
  renewalDealId  String?   @db.ObjectId
  renewalDate    DateTime
  expectedValue  Float     @default(0)
  ownerId        String?   @db.ObjectId
  status         String    @default("UPCOMING") // UPCOMING, IN_PROGRESS, RENEWED, LOST, CANCELLED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([accountId])
  @@index([contractId])
  @@index([status])
}

model ClientHandoff {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  handoffReference String    @unique // e.g. HND-00001
  dealId           String    @db.ObjectId
