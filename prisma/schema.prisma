// ----------------- LEAVE ENGINE -----------------

model LeaveType {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  code        String        @unique // CASUAL, SICK, EARNED, UNPAID, OPTIONAL
  name        String
  description String?
  colorToken  String        @default("olive") // olive, amber, blue, red
  isActive    Boolean       @default(true)
  policies    LeavePolicy[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model LeavePolicy {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  leaveTypeId     String         @db.ObjectId
  leaveType       LeaveType      @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  annualQuota     Float          @default(12) // Days per year
  accrualRate     String         @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL
  carryForwardMax Float          @default(5)
  allowHalfDay    Boolean        @default(true)
  requiresProof   Boolean        @default(false)
  minDaysBefore   Int            @default(0) // Notice period in days
  isUnpaid        Boolean        @default(false)
  effectiveYear   Int            @default(2026)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  balances        LeaveBalance[]
}

model LeaveBalance {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  employeeId     String      @db.ObjectId
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyId       String      @db.ObjectId
  policy         LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  year           Int         @default(2026)
  openingBalance Float       @default(0)
  accrued        Float       @default(0)
  used           Float       @default(0)
  adjusted       Float       @default(0)
  pending        Float       @default(0)
  available      Float       @default(0) // Formula: opening + accrued + adjusted - used - pending
  updatedAt      DateTime    @updatedAt

  @@unique([employeeId, policyId, year])
  @@index([employeeId])
}

model LeaveLedger {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  employeeId   String    @db.ObjectId
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String    @db.ObjectId
  requestId    String?   @db.ObjectId
  entryType    String    // OPENING, ACCRUAL, USAGE, ADJUSTMENT, CARRY_FORWARD, LAPSE
  days         Float     // Positive or negative
  balanceAfter Float
  remarks      String?
  createdById  String?   @db.ObjectId
  createdAt    DateTime  @default(now())

  @@index([employeeId, createdAt])
}

// ----------------- RECRUITMENT / ATS -----------------

model JobRequisition {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  reqNumber      String       @unique // e.g. REQ-00001
  title          String
  departmentId   String       @db.ObjectId
  designation    String
  headcount      Int          @default(1)
  employmentType String       @default("Full-Time")
  targetDate     DateTime
  budgetMin      Float?
  budgetMax      Float?
  reason         String?      // NEW_HEADCOUNT, REPLACEMENT, EXPANSION
  status         String       @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, CLOSED
  requestedById  String       @db.ObjectId
  approvedById   String?      @db.ObjectId
  approvedAt     DateTime?
  openings       JobOpening[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
}

model JobOpening {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  jobCode       String         @unique // e.g. JOB-00001
  requisitionId String         @db.ObjectId
  requisition   JobRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  title         String
  description   String
  requirements  String?
  location      String         @default("Headquarters")
  workMode      String         @default("OFFICE")
  experienceMin Int            @default(1)
  experienceMax Int            @default(5)
  status        String         @default("OPEN") // OPEN, PAUSED, CLOSED, FILLED
  candidates    Candidate[]
  publishedAt   DateTime       @default(now())
  closingDate   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

model Candidate {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  candidateNumber     String      @unique // e.g. CAN-00001
  openingId           String      @db.ObjectId
  opening             JobOpening  @relation(fields: [openingId], references: [id], onDelete: Cascade)
  fullName            String
  email               String
  phone               String
  currentCompany      String?
  currentCtc          Float?
  expectedCtc         Float?
  noticePeriodDays    Int?        @default(30)
  resumeUrl           String?
  skills              String[]    @default([])
  source              String      @default("PORTAL") // PORTAL, LINKEDIN, REFERRAL, AGENCY, DIRECT
  stage               String      @default("APPLIED") // APPLIED, SCREENING, SHORTLISTED, INTERVIEW, EVALUATION, OFFER, HIRED, REJECTED, WITHDRAWN
  rejectionReason     String?
  interviews          Interview[]
  offers              JobOffer[]
  convertedEmployeeId String?     // Linked EMS employee ID once hired
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([openingId])
  @@index([stage])
  @@index([email])
}

model Interview {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  interviewNumber String                @unique // e.g. INT-00001
  candidateId     String                @db.ObjectId
  candidate       Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roundName       String                // Technical Round 1, Managerial, HR Screening
  scheduledAt     DateTime
  durationMins    Int                   @default(45)
  interviewerId   String                @db.ObjectId // Employee ID
  meetingLink     String?
  status          String                @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  evaluations     InterviewEvaluation[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([candidateId])
  @@index([interviewerId])
}

model InterviewEvaluation {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  interviewId    String    @db.ObjectId
  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  rating         Int       // 1 to 5
  feedback       String
  recommendation String    // STRONG_HIRE, HIRE, HOLD, REJECT
  submittedById  String    @db.ObjectId
  submittedAt    DateTime  @default(now())
}

model JobOffer {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  offerNumber       String    @unique // e.g. OFF-00001
  candidateId       String    @db.ObjectId
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  offeredCtc        Float
  offeredRole       String
  offeredDepartment String
  joiningDate       DateTime
  expiryDate        DateTime
  offerLetterUrl    String?
  status            String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, ISSUED, ACCEPTED, DECLINED, EXPIRED
  approvedById      String?   @db.ObjectId
  issuedAt          DateTime?
  acceptedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([candidateId])
  @@index([status])
}

// ----------------- PERFORMANCE & OKRs -----------------

model PerformanceCycle {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  cycleCode      String              @unique // e.g. PERF-2026-Q3
  title          String
  startDate      DateTime
  endDate        DateTime
  reviewDeadline DateTime
  status         String              @default("GOAL_SETTING") // GOAL_SETTING, IN_PROGRESS, SELF_REVIEW, MANAGER_REVIEW, CALIBRATION, CLOSED
  goals          Goal[]
  reviews        PerformanceReview[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
}

model Goal {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  goalNumber  String           @unique // e.g. GOL-00001
  cycleId     String           @db.ObjectId
  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId  String           @db.ObjectId
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String           @default("INDIVIDUAL") // COMPANY, DEPARTMENT, TEAM, INDIVIDUAL
  weightage   Int              @default(25) // Percentage (Total = 100)
  progress    Int              @default(0) // 0 to 100%
  status      String           @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, ON_HOLD
  keyResults  KeyResult[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([employeeId, cycleId])
}

model KeyResult {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  goalId       String   @db.ObjectId
  goal         Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title        String
  targetValue  Float
  currentValue Float    @default(0)
  unit         String   @default("PERCENT") // PERCENT, NUMBER, INR
  updatedAt    DateTime @updatedAt
}

model PerformanceReview {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  cycleId            String           @db.ObjectId
  cycle              PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId         String           @db.ObjectId
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId         String           @db.ObjectId // Manager Employee ID
  selfRating         Float?
  selfComments       String?
  selfSubmittedAt    DateTime?
  managerRating      Float?
  managerComments    String?
  managerSubmittedAt DateTime?
  finalRating        Float?
  status             String           @default("PENDING_SELF") // PENDING_SELF, PENDING_MANAGER, COMPLETED, ACKNOWLEDGED
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([reviewerId])
}

