datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. AUTHENTICATION & RBAC
// ----------------------------------------------------

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  roleId           String
  role             Role         @relation(fields: [roleId], references: [id])
  isActive         Boolean      @default(true)
  isSuspended      Boolean      @default(false)
  failedAttempts   Int          @default(0)
  lockoutUntil     DateTime?
  lastLoginAt      DateTime?
  mfaSecret        String?
  mfaEnabled       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  employeeProfile  Employee?
  clientProfile    Client?
  workSessions     WorkSession[]
  auditLogs        AuditLog[]
  sessions         ActiveUserSession[]

  @@index([email])
  @@index([roleId])
}

model ActiveUserSession {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken     String       @unique
  ipAddress        String?
  userAgent        String?
  deviceType       String?
  isValid          Boolean      @default(true)
  expiresAt        DateTime
  createdAt        DateTime     @default(now())
  lastActiveAt     DateTime     @default(now())

  @@index([sessionToken])
  @@index([userId])
}

model Role {
  id               String           @id @default(uuid())
  name             String           @unique // SUPER_ADMIN, ADMIN_HR, MANAGER_TL, EMPLOYEE
  displayName      String
  description      String?
  isSystem         Boolean          @default(true)
  permissions      RolePermission[]
  users            User[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Permission {
  id               String           @id @default(uuid())
  code             String           @unique
  module           String
  description      String
  roles            RolePermission[]
}

model RolePermission {
  id               String           @id @default(uuid())
  roleId           String
  permissionId     String
  role             Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission       Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ----------------------------------------------------
// 2. ORGANIZATION & EMPLOYEES (PHASE 1 CORE + HRMS)
// ----------------------------------------------------

model Department {
  id               String       @id @default(uuid())
  name             String       @unique
  code             String       @unique
  description      String?
  teams            Team[]
  employees        Employee[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Team {
  id               String       @id @default(uuid())
  name             String
  departmentId     String
  department       Department   @relation(fields: [departmentId], references: [id])
  leadEmployeeId   String?
  employees        Employee[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([departmentId])
}

model Employee {
  id                 String            @id @default(uuid())
  employeeId         String            @unique // e.g. GI-EMP-000001
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Client Relation (Phase 1: Selected Client)
  clientId           String?
  client             Client?           @relation("ClientEmployees", fields: [clientId], references: [id])

  // Personal Information (Phase 1 Specs)
  fullName           String
  fatherMotherName   String?
  dob                DateTime?
  gender             String?
  phone              String            @unique
  personalEmail      String?
  panNumber          String?
  panMasked          String?
  aadhaarMasked      String?
  address            String?
  profilePhotoUrl    String?
  emergencyContact   String?
  emergencyName      String?

  // Employment Information (Phase 1 Specs)
  departmentId       String?
  department         Department?       @relation(fields: [departmentId], references: [id])
  departmentName     String?           // Direct text or relation name
  teamId             String?
  team               Team?             @relation(fields: [teamId], references: [id])
  designation        String
  jobLocation        String            @default("Headquarters")
  location           String            @default("Headquarters")
  joiningDate        DateTime          @default(now())
  probationEndDate   DateTime?
  employmentType     String            @default("Full-Time") // Full-Time, Contract, Part-Time, Intern, Consultant
  workMode           String            @default("OFFICE")
  shiftStartTime     String            @default("09:30")
  shiftEndTime       String            @default("18:30")
  remarks            String?

  // Status & Block/Unblock Management (Phase 1 Specs)
  status             String            @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  isBlocked          Boolean           @default(false)
  blockedReason      String?
  blockedRemarks     String?
  blockedBy          String?
  blockedAt          DateTime?
  unblockedBy        String?
  unblockedAt        DateTime?

  // Audit Info (Phase 1 Specs)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Manager Hierarchy
  reportingManagerId String?
  reportingManager   Employee?         @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id])
  subordinates       Employee[]        @relation("ManagerSubordinates")

  // Relationships
  blockHistories     EmployeeBlockHistory[]
  documents          EmployeeDocument[]
  attendanceRecords  Attendance[]
  workSessions       WorkSession[]
  leaveRequests      LeaveRequest[]
  allocatedAssets    Asset[]
  
  // CRM Relationships
  createdClients     Client[]          @relation("ClientCreator")
  assignedClients    Client[]          @relation("ClientOwner")
  assignedHistory    ClientAssignment[] @relation("AssignedToHistory")
  executedHistory    ClientAssignment[] @relation("AssignedByHistory")
  activitiesPerformed ClientActivity[]
  notesWritten       ClientNote[]
  tasksAssigned      ClientTask[]      @relation("TaskAssignee")
  tasksCreated       ClientTask[]      @relation("TaskCreator")
  notifications      Notification[]

  @@index([employeeId])
  @@index([phone])
  @@index([status])
  @@index([clientId])
  @@index([departmentId])
}

// ----------------------------------------------------
// 3. EMPLOYEE BLOCK & UNBLOCK HISTORY (PHASE 1 CORE)
// ----------------------------------------------------

model EmployeeBlockHistory {
  id                 String       @id @default(uuid())
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actionType         String       // BLOCK or UNBLOCK
  reason             String
  remarks            String?
  actionBy           String       // Admin Name / ID
  actionDate         DateTime     @default(now())
  previousStatus     String
  newStatus          String

  @@index([employeeId])
  @@index([actionDate])
  @@index([actionType])
}

// ----------------------------------------------------
// 4. CLIENT MANAGEMENT (PHASE 1 CORE + CRM EXPANSION)
// ----------------------------------------------------

model Client {
  id                 String                  @id @default(uuid())
  clientId           String                  @unique // e.g. CLI-00001
  
  // Phase 1 Fields
  companyName        String                  // Company Name
  contactPerson      String                  // Contact Person
  mobile             String                  // Mobile Number
  email              String?
  address            String?
  industry           String?                 // IT, Manufacturing, Logistics, Healthcare, Finance, Retail, etc.
  status             String                  @default("ACTIVE") // ACTIVE, INACTIVE
  dateAdded          DateTime                @default(now())

  // Authentication & Governance (Phase 1)
  userId             String?                 @unique
  user               User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  canBlockEmployees  Boolean                 @default(false)
  canDeleteEmployees Boolean                 @default(false)

  // Backwards compatibility & CRM fields
  name               String?
  phone              String?
  company            String?
  location           String?
  source             String                  @default("Direct Call")
  requirement        String?
  estimatedValue     Float?                  @default(0)
  priority           String                  @default("MEDIUM")
  stage              String                  @default("NEW")
  
  // Ownership
  createdById        String?
  createdBy          Employee?               @relation("ClientCreator", fields: [createdById], references: [id])
  assignedEmployeeId String?
  assignedEmployee   Employee?               @relation("ClientOwner", fields: [assignedEmployeeId], references: [id])
  
  lastContactedAt    DateTime?
  nextFollowUpDate   DateTime?
  tags               String                  @default("[]")
  isDuplicateMerged  Boolean                 @default(false)
  mergedIntoClientId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // Relationships
  employees          Employee[]              @relation("ClientEmployees")
  assignments        ClientAssignment[]
  activities         ClientActivity[]
  notes              ClientNote[]
  tasks              ClientTask[]
  pipelineHistory    ClientPipelineHistory[]

  @@index([clientId])
  @@index([mobile])
  @@index([status])
  @@index([industry])
  @@index([assignedEmployeeId])
  @@index([createdAt])
}

model ClientAssignment {
  id                 String       @id @default(uuid())
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromEmployeeId     String?
  toEmployeeId       String
  toEmployee         Employee     @relation("AssignedToHistory", fields: [toEmployeeId], references: [id])
  assignedById       String
  assignedBy         Employee     @relation("AssignedByHistory", fields: [assignedById], references: [id])
  assignmentReason   String?
  assignedAt         DateTime     @default(now())

  @@index([clientId])
  @@index([toEmployeeId])
}

model ClientPipelineHistory {
  id                 String        @id @default(uuid())
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStage          String
  toStage            String
  changedById        String
  remarks            String?
  timestamp          DateTime      @default(now())

  @@index([clientId])
  @@index([toStage])
}

model ClientActivity {
  id                 String       @id @default(uuid())
  activityId         String       @unique
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorEmployeeId    String
  actorEmployee      Employee     @relation(fields: [actorEmployeeId], references: [id])
  activityType       String
  title              String
  description        String?
  previousValue      String?
  newValue           String?
  metadata           String?
  ipAddress          String?
  timestamp          DateTime     @default(now())

  @@index([clientId])
  @@index([actorEmployeeId])
  @@index([timestamp])
  @@index([activityType])
}

model ClientNote {
  id                 String       @id @default(uuid())
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId           String
  author             Employee     @relation(fields: [authorId], references: [id])
  content            String
  isPinned           Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([clientId])
}

model ClientTask {
  id                 String        @id @default(uuid())
  taskId             String        @unique
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedToId       String
  assignedTo         Employee      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById        String
  createdBy          Employee      @relation("TaskCreator", fields: [createdById], references: [id])
  taskType           String
  title              String
  description        String?
  priority           String        @default("MEDIUM")
  dueDate            DateTime
  reminderTime       DateTime?
  status             String        @default("PENDING")
  completedAt        DateTime?
  completionNotes    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([clientId])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
}

// ----------------------------------------------------
// 5. SECURE KYC & DOCUMENT VAULT (FUTURE READY)
// ----------------------------------------------------

model EmployeeDocument {
  id                 String                     @id @default(uuid())
  documentId         String                     @unique
  employeeId         String
  employee           Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType       String
  title              String
  fileStoragePath    String
  mimeType           String                     @default("application/pdf")
  fileSizeBytes      Int                        @default(102400)
  verificationStatus String                     @default("PENDING_VERIFICATION")
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?
  expiryDate         DateTime?
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  accessLogs         DocumentAccessLog[]

  @@index([employeeId])
  @@index([documentType])
  @@index([verificationStatus])
}

model DocumentAccessLog {
  id                 String           @id @default(uuid())
  documentId         String
  document           EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accessedByEmployeeId String
  actionType         String
  ipAddress          String?
  userAgent          String?
  accessedAt         DateTime         @default(now())

  @@index([documentId])
  @@index([accessedByEmployeeId])
}

// ----------------------------------------------------
// 6. ATTENDANCE & WORK SESSIONS (FUTURE READY)
// ----------------------------------------------------

model Attendance {
  id                 String            @id @default(uuid())
  employeeId         String
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date               String
  checkInTime        DateTime?
  checkOutTime       DateTime?
  status             String            @default("PRESENT")
  isLate             Boolean           @default(false)
  isEarlyCheckout    Boolean           @default(false)
  totalWorkMinutes   Int               @default(0)
  totalBreakMinutes  Int               @default(0)
  overtimeMinutes    Int               @default(0)
  checkInIp          String?
  checkOutIp         String?
  remarks            String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  breaks             AttendanceBreak[]

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

model AttendanceBreak {
  id                 String       @id @default(uuid())
  attendanceId       String
  attendance         Attendance   @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  breakStartTime     DateTime     @default(now())
  breakEndTime       DateTime?
  durationMinutes    Int          @default(0)
  breakType          String       @default("TEA_LUNCH")
  createdAt          DateTime     @default(now())

  @@index([attendanceId])
}

model WorkSession {
  id                 String        @id @default(uuid())
  sessionId          String        @unique
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loginTimestamp     DateTime      @default(now())
  logoutTimestamp    DateTime?
  sessionDurationSec Int           @default(0)
  activeSeconds      Int           @default(0)
  ipAddress          String?
  userAgent          String?
  deviceInfo         String?
  status             String        @default("ACTIVE")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([employeeId])
  @@index([sessionId])
  @@index([status])
}

// ----------------------------------------------------
// 7. LEAVE & ASSET MANAGEMENT (FUTURE READY)
// ----------------------------------------------------

model LeaveRequest {
  id                 String       @id @default(uuid())
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          String
  startDate          String
  endDate            String
  totalDays          Float
  reason             String
  status             String       @default("PENDING")
  reviewedById       String?
  reviewedAt         DateTime?
  reviewRemarks      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([employeeId])
  @@index([status])
}

model Asset {
  id                 String       @id @default(uuid())
  assetTag           String       @unique
  name               String
  assetType          String
  serialNumber       String       @unique
  assignedEmployeeId String?
  assignedEmployee   Employee?    @relation(fields: [assignedEmployeeId], references: [id])
  assignedDate       DateTime?
  returnDate         DateTime?
  condition          String       @default("GOOD")
  status             String       @default("ALLOCATED")
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([assignedEmployeeId])
  @@index([assetTag])
}

// ----------------------------------------------------
// 8. NOTIFICATIONS & IMMUTABLE AUDIT LOGS
// ----------------------------------------------------

model Notification {
  id                 String       @id @default(uuid())
  recipientId        String
  recipient          Employee     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title              String
  message            String
  category           String
  entityType         String?
  entityId           String?
  isRead             Boolean      @default(false)
  readAt             DateTime?
  createdAt          DateTime     @default(now())

  @@index([recipientId])
  @@index([isRead])
}

model AuditLog {
  id                 String       @id @default(uuid())
  actorUserId        String?
  actorUser          User?        @relation(fields: [actorUserId], references: [id])
  actorEmployeeId    String?
  action             String
  entityType         String
  entityId           String?
  previousData       String?
  newData            String?
  reason             String?
  ipAddress          String?
  userAgent          String?
  status             String       @default("SUCCESS")
  timestamp          DateTime     @default(now())

  @@index([actorEmployeeId])
  @@index([action])
  @@index([entityType])
  @@index([timestamp])
}

model SystemSetting {
  id                 String       @id @default(uuid())
  key                String       @unique
  value              String
  category           String
  description        String?
  updatedByEmployeeId String?
  updatedAt          DateTime     @updatedAt
}
