model HrRequestType {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  code        String      @unique // LETTER, ADDRESS_CHANGE, BANK_CHANGE, SHIFT_CHANGE, PROMOTION, GENERAL
  name        String
  description String?
  formSchema  String?     // JSON dynamic form field definitions
  isActive    Boolean     @default(true)
  requests    HrRequest[]
}

model HrRequest {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  reqNumber       String        @unique // e.g. HRR-00001
  typeId          String        @db.ObjectId
  type            HrRequestType @relation(fields: [typeId], references: [id])
  employeeId      String        @db.ObjectId
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subject         String
  details         String        // JSON payload matching formSchema
  status          String        @default("SUBMITTED") // SUBMITTED, IN_REVIEW, APPROVED, REJECTED, COMPLETED
  assignedToId    String?       @db.ObjectId
  resolutionNotes String?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
}

model HelpdeskTicket {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber String            @unique // e.g. TCK-00001
  employeeId   String            @db.ObjectId
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category     String            // PAYROLL, LEAVE, ATTENDANCE, BENEFITS, WORKPLACE, IT
  priority     String            @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  subject      String
  description  String
  status       String            @default("OPEN") // OPEN, IN_PROGRESS, WAITING, RESOLVED, CLOSED
  assignedToId String?           @db.ObjectId
  comments     HelpdeskComment[]
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([employeeId])
  @@index([status])
}

model HelpdeskComment {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  ticketId      String         @db.ObjectId
  ticket        HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String         @db.ObjectId
  authorName    String
  authorRole    String
  message       String
  attachmentUrl String?
  createdAt     DateTime       @default(now())

  @@index([ticketId])
}

// ====================================================
// 12. FIRST-CLASS PAYROLL DOMAIN
// ====================================================

model PayrollPeriod {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  periodCode      String               @unique // e.g. PAY-2026-09
  month           Int                  // 1 - 12
  year            Int                  // e.g. 2026
  startDate       DateTime             // e.g. 2026-09-01
  endDate         DateTime             // e.g. 2026-09-30
  payDate         DateTime             // e.g. 2026-10-01
  status          String               @default("DRAFT") // DRAFT, OPEN, PROCESSING, PENDING_REVIEW, APPROVED, FINALIZED, LOCKED
  totalEmployees  Int                  @default(0)
  totalGross      Float                @default(0)
  totalDeductions Float                @default(0)
  totalNet        Float                @default(0)
  processedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?              @db.ObjectId
  finalizedAt     DateTime?
  finalizedById   String?              @db.ObjectId
  payrollRecords  PayrollRecord[]
  approvals       PayrollApprovalLog[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([year, month])
}

model SalaryComponent {
  id                  String                     @id @default(auto()) @map("_id") @db.ObjectId
  code                String                     @unique // BASIC, HRA, SPECIAL_ALLOWANCE, MEDICAL, BONUS, PF_EMP, ESI_EMP, TDS, PT
  name                String
  type                String                     // EARNING, DEDUCTION
  calculationType     String                     @default("FIXED") // FIXED, PERCENTAGE, FORMULA
  percentageOf        String?                    // Reference component code, e.g. "BASIC"
  percentageValue     Float?                     // e.g. 50% of Basic for HRA
  formula             String?                    // Calculation expression
  isTaxable           Boolean                    @default(true)
  isStatutory         Boolean                    @default(false)
  isRecurring         Boolean                    @default(true)
  calculationPriority Int                        @default(10) // Calculation order
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  
  structureComponents SalaryStructureComponent[]
}

model SalaryStructure {
  id          String                     @id @default(auto()) @map("_id") @db.ObjectId
  code        String                     @unique // e.g. STR-EXECUTIVE, STR-OPERATIONS, STR-TECH
  name        String
  description String?
  isActive    Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  components  SalaryStructureComponent[]
  assignments EmployeeSalaryAssignment[]
}

model SalaryStructureComponent {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  structureId     String          @db.ObjectId
  structure       SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  componentId     String          @db.ObjectId
  component       SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  defaultAmount   Float?          @default(0)
  formulaOverride String?

  @@unique([structureId, componentId])
}

model EmployeeSalaryAssignment {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  employeeId    String          @db.ObjectId
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structureId   String          @db.ObjectId
  structure     SalaryStructure @relation(fields: [structureId], references: [id])
  monthlyCtc    Float
  annualCtc     Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  version       Int             @default(1)
  isCurrent     Boolean         @default(true)
  bankAccount   String?
  bankIfsc      String?
  panNumber     String?
  assignedById  String?         @db.ObjectId
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([employeeId, isCurrent])
}

model PayrollRecord {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  periodId         String          @db.ObjectId
  period           PayrollPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId       String          @db.ObjectId
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // Working days inputs from EMS & Leave
  totalDaysInMonth Int             @default(30)
  payableDays      Float           @default(30)
  presentDays      Float           @default(30)
  paidLeaveDays    Float           @default(0)
  unpaidDays       Float           @default(0) // LOP
  overtimeHours    Float           @default(0)

  // Computed Financials
  baseGross        Float           @default(0)
  lopDeduction     Float           @default(0)
  totalEarnings    Float           @default(0)
  totalDeductions  Float           @default(0)
  reimbursements   Float           @default(0)
  netPay           Float           @default(0)
  
  status           String          @default("PROCESSED") // PROCESSED, REVIEWED, APPROVED, FINALIZED, HOLD
  calculationTrace String?         // Detailed JSON step-by-step audit trace

  earningsItems    PayrollEarningItem[]
  deductionItems   PayrollDeductionItem[]
  adjustmentItems  PayrollAdjustmentItem[]
  payslip          Payslip?
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
  @@index([periodId])
}

model PayrollEarningItem {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  payrollRecordId String        @db.ObjectId
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  componentCode   String        // BASIC, HRA, SPECIAL_ALLOWANCE
  componentName   String
  standardAmount  Float
  actualAmount    Float
}

model PayrollDeductionItem {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  payrollRecordId String        @db.ObjectId
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  componentCode   String        // LOP, PF_EMP, ESI_EMP, TDS, PT, LOAN_EMI
  componentName   String
  amount          Float
}

model PayrollAdjustmentItem {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  payrollRecordId String        @db.ObjectId
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  type            String        // BONUS, ARREAR, INCENTIVE, PENALTY, CORRECTION
  amount          Float         // Positive or negative
  reason          String
}

model ReimbursementClaim {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  claimNumber    String    @unique // e.g. RMB-00001
  employeeId     String    @db.ObjectId
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category       String    // TRAVEL, MEALS, INTERNET, STATIONERY, CLIENT_ENTERTAINMENT
  amount         Float
  claimDate      DateTime
  description    String
  receiptUrl     String?
  status         String    @default("SUBMITTED") // SUBMITTED, APPROVED_MANAGER, APPROVED_FINANCE, PAID, REJECTED
  approvedById   String?   @db.ObjectId
  approvedAt     DateTime?
  paidInPeriodId String?   @db.ObjectId
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
}

model EmployeeLoan {
  id                String                  @id @default(auto()) @map("_id") @db.ObjectId
  loanNumber        String                  @unique // e.g. LON-00001
  employeeId        String                  @db.ObjectId
  employee          Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loanType          String                  @default("ADVANCE") // SALARY_ADVANCE, PERSONAL_LOAN, EMERGENCY
  principalAmount   Float
  monthlyEmi        Float
  totalTenureMonths Int
  remainingBalance  Float
  repaidAmount      Float                   @default(0)
  disbursedDate     DateTime?
  status            String                  @default("PENDING") // PENDING, ACTIVE, REPAID, DEFAULTED, REJECTED
  schedules         LoanRepaymentSchedule[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([employeeId])
  @@index([status])
}

model LoanRepaymentSchedule {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  loanId           String       @db.ObjectId
  loan             EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNo    Int
  dueDate          DateTime
  amount           Float
  status           String       @default("PENDING") // PENDING, DEDUCTED, WAIVED
  deductedInPeriod String?      // Payroll period code
}

model Payslip {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  payslipNumber   String        @unique // e.g. PSL-2026-09-00001
  payrollRecordId String        @unique @db.ObjectId
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  employeeId      String        @db.ObjectId
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodCode      String        // e.g. PAY-2026-09
  grossEarnings   Float
  totalDeductions Float
  netSalary       Float
  netSalaryWords  String
  bankMasked      String?
  panMasked       String?
  fileStoragePath String?
  isPublished     Boolean       @default(false)
  downloadToken   String?       @unique
  generatedAt     DateTime      @default(now())

  @@index([employeeId])
  @@index([periodCode])
}

model PayrollApprovalLog {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  periodId  String        @db.ObjectId
  period    PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  action    String        // PROCESSED, REVIEWED, APPROVED, FINALIZED, REOPENED
  actorId   String        @db.ObjectId
  actorName String
  remarks   String?
  timestamp DateTime      @default(now())

  @@index([periodId])
}

