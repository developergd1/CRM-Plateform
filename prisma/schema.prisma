  processedById    String?   @db.ObjectId
  processedAt      DateTime?
  rejectionReason  String?
  createdClientId  String?   @db.ObjectId
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([dealId])
  @@index([accountId])
  @@index([status])
}

model SalesGoal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  dimension   String   @default("USER") // USER, TEAM, ORGANIZATION
  targetType  String   @default("REVENUE") // REVENUE, DEALS_WON, NEW_ACCOUNTS, NEW_LEADS
  targetValue Float
  period      String   // e.g. "2026-Q3", "2026-09"
  startDate   DateTime
  endDate     DateTime
  userId      String?  @db.ObjectId
  teamId      String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CrmWorkflow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  trigger     String   // LEAD_CREATED, LEAD_QUALIFIED, DEAL_STAGE_CHANGED, DEAL_WON, CONTRACT_EXPIRING
  conditions  String   // JSON condition rules
  actions     String   // JSON action specifications
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CrmCustomField {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  entityType String   // LEAD, ACCOUNT, CONTACT, DEAL
  fieldKey   String   // e.g. "taxExemptNumber"
  label      String   // e.g. "Tax Exemption ID"
  fieldType  String   // TEXT, NUMBER, DATE, BOOLEAN, SELECT, MULTI_SELECT, EMAIL, PHONE, URL
  options    String[] @default([])
  isRequired Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([entityType, fieldKey])
}

// ====================================================
// 11. ENTERPRISE HRM MODELS
// ====================================================

model HrPolicy {
  id            String                  @id @default(auto()) @map("_id") @db.ObjectId
  policyCode    String                  @unique // e.g. POL-00001
  title         String
  category      String                  // CODE_OF_CONDUCT, LEAVE, ATTENDANCE, IT_SECURITY, PAYROLL, BENEFITS
